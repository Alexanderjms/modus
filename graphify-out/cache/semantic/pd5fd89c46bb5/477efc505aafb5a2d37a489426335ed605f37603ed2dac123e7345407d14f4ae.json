    {
      "id": "ref_13_proyectos_vista_general_export_global_search_field",
      "label": "Search Field (Buscar en modus\u2026)",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Pinned in the top header so global search is always reachable regardless of the section shown; placeholder names the product ('modus') instead of the scope."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_project_search_field",
      "label": "Project Search Field",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Scoped search lives inside the content toolbar ('Buscar proyectos\u2026') so it filters only the grid, deliberately separate from the header's global search."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_filter_tabs",
      "label": "Filter Tabs (Todos / Activos / Completados / Archivados)",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Segmented control in a #F0F0F2 track; the selected tab is a raised white pill with a soft shadow, encoding selection by elevation instead of an underline."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_sort_control",
      "label": "Sort Button (Ordenar por: \u00daltima actividad)",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Shows the active sort value inline ('\u00daltima actividad') with an up/down arrow icon plus chevron, so the current ordering is legible without opening the control."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_new_project_button",
      "label": "Nuevo proyecto Button",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
