    {
      "id": "ref_13_proyectos_vista_general_export_proyectos_vista_general",
      "label": "13 \u00b7 Proyectos \u2014 Vista general (Projects Overview Screen)",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Light-theme modus workspace artboard (1728x1080) presenting all projects as a two-column card grid so the user can scan progress, ownership and status at a glance; the header pairs the section badge with a global search, while the toolbar carries list-scoping controls."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_proyectos_menu_de_proyecto",
      "label": "14 \u00b7 Proyectos \u2014 Men\u00fa de proyecto (Project Menu Screen)",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Second artboard of the export: the identical Proyectos layout rendered together with the project card context menu, used to document the per-card action state rather than a different page."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_card_menu",
      "label": "Card Menu (Project Context Menu)",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Floating 224px popover anchored to the card's ellipsis button; six actions are split into three groups by dividers (Abrir / Editar / Duplicar \u2014 Marcar como completado / Archivar \u2014 Eliminar) so destructive 'Eliminar' is isolated and tinted #B3261E."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_projects_grid",
      "label": "Projects Grid",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
