    {
      "id": "ref_13_proyectos_vista_general_export_project_card",
      "label": "Project Card",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Uniform card anatomy (icon + name + ellipsis, description, progress row, meta row, status row) keeps every project comparable; state variants change only the trailing affordances (hover actions for active cards, restaurar/eliminar for archived, a Completado/Archivado chip in the header)."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_sidebar_navigation",
      "label": "Sidebar Navigation (App Nav Rail)",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Icon-only 52px rail (Inicio, Proyectos, Tareas, Configuraci\u00f3n + avatar) keeps the canvas width for content; the active destination is signalled by a filled #007AFF tile."
    },
