    },
    {
      "id": "ref_13_proyectos_vista_general_export_progress_bar",
      "label": "Progress Row (Track / Fill / Percent)",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "5px track with a #007AFF fill (w-[128px] fixed sample widths in the export) plus a numeric percentage label, giving both a glanceable and an exact completion signal."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_avatar_stack",
      "label": "Avatar Stack",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Overlapping 18px initials avatars with white outlines (AL, MG) show collaborator presence inside a 30px slot without expanding the meta row."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_status_chip",
      "label": "Project Status Chip (Completado / Archivado)",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Replaces the ellipsis button in the card header for terminal states, making finished/archived cards visually distinct at grid level."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_hover_actions",
      "label": "Hover Actions (Abrir proyecto)",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Primary action is revealed at the bottom of the card (states described as hover-revealed) to keep the resting card clean while giving a one-click path into the project."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_archived_actions",
      "label": "Archived Actions (Restaurar / Eliminar)",
      "file_type": "code",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Archived cards swap the open action for Restaurar plus a destructive trash control, giving archived items a recover-or-delete exit path."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_ambient_glow",
      "label": "Ambient Glow Backdrop",
      "file_type": "rationale",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Four 640px radial-gradient ellipses (#4D9BFF, #B37DF0, #FFB86B, #5AC8FA at ~24% alpha) layered behind the content at z-index 0-3; they add depth and brand colour to a flat #F2F2F4 canvas without competing with the white surface cards stacked above (z-index 4+)."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_modus",
      "label": "modus (Application)",
      "file_type": "concept",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Product identity implied by the search placeholder 'Buscar en modus\u2026' and the sparkles app logo; the design is an app shell (logo + nav rail + section header + content) rather than a standalone page."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_project_entity",
      "label": "Project (Domain Entity)",
      "file_type": "concept",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Fields evidenced by the card: name, icon/colour, description, percent complete, task count ('14 / 40 tareas'), assignee avatars, in-progress task count, last-updated timestamp and status."
    },
    {
      "id": "ref_13_proyectos_vista_general_export_project_lifecycle_states",
      "label": "Project Lifecycle States (Activo / En progreso / Completado / Archivado)",
      "file_type": "concept",
      "source_file": "ref/13 \u00b7 Proyectos \u2014 Vista general-export.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A four-state model reused across the UI: the filter tabs name the states, the card header chip displays the terminal ones, and the status row shows live progress ('3 en progreso', 'Completado hace 2 semanas', 'Archivado hace 1 mes')."
    },
